{
  "name": "anyfare",
  "version": "0.1.0",
  "private": true,
  "description": "A payment router for AI agents",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "clean": "tsc -b --clean",
    "dev:api": "node --env-file-if-exists=.env --watch packages/api/dist/main.js",
    "typecheck": "tsc -b && npm run typecheck --workspaces",
    "test": "vitest run --project '!*:*'",
    "test:integration": "vitest run --project '*:integration'",
    "test:functional": "vitest run --project '*:functional'",
    "test:all": "vitest run",
    "db:generate": "npm run db:generate -w @anyfare/db",
    "db:migrate": "tsc -b packages/db && node --env-file-if-exists=.env packages/db/dist/migrate.js",
    "seed:local": "tsc -b packages/testing && node --env-file-if-exists=.env packages/testing/dist/local/seedMain.js",
    "stack:local": "tsc -b packages/testing && node --env-file-if-exists=.env packages/testing/dist/local/stackMain.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
