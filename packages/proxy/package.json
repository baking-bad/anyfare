{
  "name": "@anyfare/proxy",
  "version": "0.1.0",
  "private": true,
  "description": "App: the payment proxy",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run --root ../.. --project proxy",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@anyfare/common": "0.1.0",
    "@anyfare/core": "0.1.0",
    "@anyfare/db": "0.1.0",
    "@anyfare/payments": "0.1.0",
    "@prometheus-io/client": "^0.16.1",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@anyfare/testing": "0.1.0"
  }
}
