{
  "name": "@anyfare/signer",
  "version": "0.1.0",
  "private": true,
  "description": "App: signs payments to routed targets",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run --root ../.. --project signer",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@anyfare/common": "0.1.0",
    "@anyfare/core": "0.1.0",
    "@anyfare/db": "0.1.0",
    "@near-js/crypto": "2.5.1",
    "@near-js/signers": "2.5.1",
    "@near-js/transactions": "2.5.1",
    "@prometheus-io/client": "^0.16.1",
    "@solana/kit": "8.6.0",
    "@x402/core": "2.30.0",
    "@x402/evm": "2.30.0",
    "@x402/near": "2.30.0",
    "@x402/svm": "2.30.0",
    "fastify": "^5.12.8",
    "mppx": "0.13.1",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@anyfare/testing": "0.1.0"
  }
}
