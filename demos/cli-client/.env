# Where Anyfare runs. These are the hosted demo's addresses.
ANYFARE_API_URL=https://api.anyfare.agents.bakingbad.dev
ANYFARE_PAY_URL=https://pay.anyfare.agents.bakingbad.dev

# The most the app pays for one call, in US dollars. It checks this before it signs or sends anything.
MAX_PAYMENT_USD=0.02

# Secrets go in .env.local, never in this file. .env.local is not committed.
# The app can write the Anyfare keys there for you after sign-up.
#
# Credits:
# ANYFARE_MASTER_KEY=afm_live_…
# ANYFARE_PAYMENT_KEY=af_live_…
#
# USDC on NEAR:
# NEAR_ACCOUNT_ID=…
# NEAR_PRIVATE_KEY=ed25519:…
# NEAR_RPC_URL=…            optional
#
# USDC on Base:
# BASE_PRIVATE_KEY=0x…
# BASE_RPC_URL=…            optional, to read the wallet's balance
#
# USDC.e on Tempo:
# TEMPO_PRIVATE_KEY=0x…
# TEMPO_RPC_URL=…           optional
