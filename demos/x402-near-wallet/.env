# The most the app pays for one call, in US dollars. It checks this before it signs anything.
MAX_PAYMENT_USD=0.02

# Where the "through Anyfare" link points.
ANYFARE_PAY_URL=https://pay.anyfare.agents.bakingbad.dev

# Secrets go in .env.local, never in this file. .env.local is not committed.
#
# NEAR_ACCOUNT_ID=…         the wallet, such as alice.near
# NEAR_PRIVATE_KEY=ed25519:…  a key of that account. Needed to pay; not for balance or --dry-run
# NEAR_RPC_URL=…            optional, must be https
