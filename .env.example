# The platform config file. Comma-separated files merge left to right.
CONFIG_PATH=

# Postgres connection string for the apps and `npm run db:migrate`.
DATABASE_URL=

# Redis connection string for the apps.
REDIS_URL=

# Log level for every app: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=

# The proxies in front whose X-Forwarded-For gives the client IP: addresses, CIDR ranges, or names such
# as uniquelocal, comma-separated. Leave it empty locally. Behind Traefik it must name Traefik's network,
# or every client counts as Traefik's address and the per-IP limits are global.
TRUST_PROXY=

# The internal API's shared secret: at least 32 characters. Callers send it in x-internal-secret.
# The internal API listens on INTERNAL_PORT, 8082 by default, never behind Traefik.
INTERNAL_API_SECRET=

# The CDP facilitator's key, named in the platform config. An Ed25519 key in base64, or a P-256 PEM with
# each newline written as \n.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Facilitator
#
# The NEAR facilitator's shared secret, named in the platform config: at least 32 characters. The proxy
# sends it in X-API-Key, and our facilitator checks it.
FACILITATOR_SECRET=

# Facilitator: the relayer, the NEAR account that submits the buyers' signed delegate actions and pays
# their gas. A payment from this account is refused.
FACILITATOR_NEAR_ACCOUNT=relay.anyfare.testnet

# Facilitator: the relayer's full-access key, ed25519: and base58. Taken out of the environment once read.
# Never commit a real one.
FACILITATOR_NEAR_KEY=

# Facilitator: the accounts it takes payments to, comma-separated: pay.anyfare.testnet,other.anyfare.testnet.
# Empty: the payTo of the platform config's NEAR assets. A payment to any other is refused.
FACILITATOR_RECIPIENTS=

# The Solana RPC for the treasury's balance reader and the Signer's Solana payments. A secret: it may carry
# a key in its path, such as https://sol.nownodes.io/<key>. Empty: Solana's public RPC, rate limited.
# Never commit a real one.
SOLANA_RPC_URL=

# Proxy: where the Signer listens. Empty: the proxy pays no routed targets.
SIGNER_URL=http://127.0.0.1:8083

# Proxy: where the internal API listens, to register routed endpoints. Empty: it registers none.
# The proxy sends INTERNAL_API_SECRET with each call.
INTERNAL_API_URL=http://127.0.0.1:8082

# Proxy: the HMAC key that binds each MPP challenge to its contents. At least 32 bytes, the same on every replica.
MPP_SECRET_KEY=change-me-to-at-least-32-characters-long

# Signer and proxy: the Signer's shared secret. At least 32 characters.
SIGNER_SECRET=change-me-to-at-least-32-characters-long

# Signer: the hot wallet keys. Empty: no wallet on that chain, so nothing is paid there. Never commit a real one.
# Base and Tempo: 0x and 64 hex characters.
SIGNER_BASE_KEY=
SIGNER_TEMPO_KEY=
# Solana: base58, or a JSON array of 64 numbers.
SIGNER_SOLANA_KEY=

# Signer: the NEAR hot wallet's account, which buyers pay too. Set it and SIGNER_NEAR_KEY together, or neither.
# It must be signer.wallets.near when the platform config names one.
SIGNER_NEAR_ACCOUNT=
# Signer: that account's full-access key, ed25519: and base58. Taken out of the environment once read.
# Empty: nothing is paid on NEAR. Never commit a real one.
SIGNER_NEAR_KEY=

# Signer: it reads REDIS_URL like the other apps, and the stack gives it a Redis of its own,
# so the Signer's limits and records stay apart from the proxy's replay store.
# Signer: with rebalancing on, it reads ONECLICK_API_KEY too, when topups.apiKey names it.

# Workers: RPC URLs by network, overriding the public ones: eip155:8453=https://...,eip155:4217=https://...
# Without credentials.
EVM_RPC_URLS=eip155:8453=https://base-rpc.example.com,eip155:4217=https://tempo-rpc.example.com

# The 1Click API key of NEAR Intents. Optional: the API, the workers, and the Signer with rebalancing on read it
# when the platform config's topups.apiKey names this variable. Never commit a real one.
ONECLICK_API_KEY=

# Workers, facilitator, and Signer: the NEAR RPC of the platform config's NEAR network, near:testnet=https://...
# or near:mainnet=https://... The facilitator settles through it, and the Signer reads the hot wallet's nonce
# and the chain's height through its first item. The workers read the treasury's NEAR balances and the chain's
# height through the items in order, then the x402 SDK's public RPC when they fail. Empty: the x402 SDK's public
# RPC. A key goes in the URL's path or query string, never as a username or password: only the host is logged.
# Never commit a real one.
NEAR_RPC_URLS=

# Website
#
# The website reads these from the environment at run time, and each has a default. Locally, the compose
# profile web sets them for the apps run on this machine.
# The website's own origin, as the browser reaches it.
SITE_URL=
# The console's origin: the website's Console button links here, and requests for this host name get the Console.
CONSOLE_URL=
# The public API and the pay host, as the browser reaches them.
API_URL=
PAY_URL=
# The public API and the pay host, as the web server reaches them. Empty: the same as API_URL and PAY_URL.
API_INTERNAL_URL=
PAY_INTERNAL_URL=

# PORT, METRICS_PORT, INTERNAL_PORT and HOST have a default per app and are set per process, never here.

# Postgres connection string for the tests. The role may create databases: each test file gets its own.
TEST_DATABASE_URL=

# Redis connection string for the tests.
TEST_REDIS_URL=

# Compose: the host port of the local Postgres.
POSTGRES__PORT=

# Compose: the local Postgres user.
POSTGRES__USER=

# Compose: the local Postgres password.
POSTGRES__PASSWORD=

# Compose: the local Postgres database name.
POSTGRES__DB=

# Compose: the host port of the local Redis.
REDIS__PORT=

# Compose: the local Redis password.
REDIS__PASSWORD=

# Compose: the host port of the Signer's local Redis.
SIGNER_REDIS__PORT=

# Compose: the Signer's local Redis password.
SIGNER_REDIS_PASSWORD=
